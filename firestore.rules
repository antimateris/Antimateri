rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection: Anyone can create orders and read for tracking
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    // Settings collection: Anyone can read settings, write permitted
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Prices collection: Anyone can read package prices
    match /prices/{priceId} {
      allow read, write: if true;
    }

    // WhatsApp logs: read and write permitted
    match /waLogs/{logId} {
      allow read, write: if true;
    }

    // Customers collection: user gamification and accounts
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Admin profiles
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
