# ==========================================
# DOKU PAYMENT GATEWAY (WAJIB / REQUIRED)
# Diperoleh dari Dashboard DOKU Merchant (Production / Sandbox)
# ==========================================
DOKU_CLIENT_ID=your-doku-client-id-here
DOKU_SECRET_KEY=your-doku-secret-key-here

# Mode Payment Gateway: 'sandbox' atau 'production'
DOKU_MODE=sandbox

# ==========================================
# GEMINI AI API KEY
# ==========================================
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ==========================================
# APPLICATION HOSTING URL
# ==========================================
APP_URL=MY_APP_URL

